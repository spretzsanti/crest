{
  "name": "crest",
  "private": true,
  "version": "1.1.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "i18n": "node scripts/i18n-check.mjs",
    "bump": "node scripts/bump.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "preview": "vite preview",
    "tauri": "tauri",
    "site:dev": "vite --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts && vite build --mode demo --base ./ --outDir dist-site/demo",
    "site:test": "node --test \"site/src/*.test.ts\" \"site/feedback-worker/test/*.test.mjs\"",
    "site:preview": "vite preview --config site/vite.config.ts --port 4180 --strictPort"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
